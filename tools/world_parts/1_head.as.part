// six clip planes from a view-projection (WebGPU depth 0..1)
class Frustum {
    p: StaticArray<f64> = new StaticArray<f64>(24);

    set(m: Mat4): void {
        let a = m.m;
        for (let k = 0; k < 6; k++) {
            let r = k >> 1;
            let sgn: f64 = (k & 1) == 0 ? 1 : -1;
            let o = k * 4;
            for (let c = 0; c < 4; c++) {
                let w = <f64>a[c * 4 + 3];
                let v = <f64>a[c * 4 + r];
                if (k == 4) {
                    this.p[o + c] = v;                 // near: z >= 0
                } else if (k == 5) {
                    this.p[o + c] = w - <f64>a[c * 4 + 2]; // far: z <= w
                } else {
                    this.p[o + c] = w + sgn * v;
                }
            }
        }
    }

    visible(c: Chunk): bool {
        for (let k = 0; k < 6; k++) {
            let o = k * 4;
            let a = this.p[o];
            let b = this.p[o + 1];
            let cc = this.p[o + 2];
            let d = this.p[o + 3];
            let x = a > 0 ? c.maxX : c.minX;
            let y = b > 0 ? c.maxY : c.minY;
            let z = cc > 0 ? c.maxZ : c.minZ;
            if (a * x + b * y + cc * z + d < 0) {
                return false;
            }
        }
        return true;
    }
}

