class Rect {
    x0: f64;
    y0: f64;
    x1: f64;
    y1: f64;
    constructor(x0: f64, y0: f64, x1: f64, y1: f64) {
        this.x0 = x0;
        this.y0 = y0;
        this.x1 = x1;
        this.y1 = y1;
    }
    hits(o: Rect): bool {
        return this.x0 < o.x1 && o.x0 < this.x1 && this.y0 < o.y1 && o.y0 < this.y1;
    }
}

