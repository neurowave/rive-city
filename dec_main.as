// GENERATED by tools/gen.py from tools/decrypt.as.tmpl (cue = cue)
// Scripted data converter for text binds (from RiveBox), AnimaScript port.
//
// When the bound string changes, or the cue number in the view model is
// bumped (world.as bumps it as the dials / HUD arrive during the boot), the
// string replays a decrypt: full-length cipher noise first, then a left->right
// front resolves it into the real characters. Noise keeps each character's
// class, so layouts never reflow. One instance per bind, each on its own
// clock with a small golden-ratio stagger.
import { Converter, Context } from "rive/host";
import { DataValue, DataValueString } from "rive/data_value";
import { PropertyNumber } from "rive/data";

const CUE = "cue";
const UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%&*+=<>/";
const LOWER = "abcdefghijklmnopqrstuvwxyz";
const DIGIT = "0123456789";
let count: i32 = 0;

function hash(n: f64): f64 {
    let x = Math.sin(n * 12.9898 + 78.233) * 43758.5453;
    return x - Math.floor(x);
}

export class Decrypt_main extends Converter {
    ctx: Context? = null;
    pCue: PropertyNumber? = null;
    lastCue: f64 = 0;
    target: string = "";
    t: f64 = 0;
    delay: f64 = 0;
    done: bool = false;
    id: i32 = 0;

    private restart(): void {
        this.t = 0;
        this.done = false;
        let c = this.ctx;
        if (c != null) {
            c.markNeedsUpdate();
        }
    }

    override init(context: Context): bool {
        count++;
        this.id = count;
        this.ctx = context;
        let g = <f64>count * 0.6180339887;
        this.delay = (g - Math.floor(g)) * 0.25;
        let vm = context.viewModel();
        if (vm != null) {
            this.pCue = vm.getNumber(CUE);
        }
        let pc = this.pCue;
        this.lastCue = pc != null ? pc.value : 0;
        return true;
    }

    override convert(input: DataValue): DataValue? {
        if (!input.isString()) {
            return null;
        }
        let s = (<DataValueString>input).value;
        if (s != this.target) {
            this.target = s;
            this.restart();
        }
        let n = s.length;
        if (this.done || n == 0) {
            return new DataValueString(s);
        }
        let t = this.t;
        let cps = Math.min(Math.max(<f64>n / 0.45, 24), 110);
        let hold = 0.12 + this.delay;
        let step = Math.floor(this.t * 30);
        let out = "";
        let all = true;
        for (let i = 0; i < n; i++) {
            let b = s.charCodeAt(i);
            let tResolve = hold + <f64>i / cps;
            if (t >= tResolve || b == 32 || b > 127) {
                out += String.fromCharCode(b);
            } else {
                all = false;
                let r = hash(<f64>(i + 1) * 131 + step * 7919 + <f64>this.id * 31);
                let pool = "";
                if (b >= 65 && b <= 90) {
                    pool = UPPER;
                } else if (b >= 97 && b <= 122) {
                    pool = LOWER;
                } else if (b >= 48 && b <= 57) {
                    pool = DIGIT;
                }
                if (pool.length > 0) {
                    let k = <i32>Math.floor(r * <f64>pool.length);
                    out += String.fromCharCode(pool.charCodeAt(k));
                } else {
                    out += String.fromCharCode(b);
                }
            }
        }
        if (all) {
            this.done = true;
            return new DataValueString(s);
        }
        return new DataValueString(out);
    }

    override reverseConvert(input: DataValue): DataValue? {
        return input;
    }

    override advance(seconds: f64): bool {
        let pc = this.pCue;
        if (pc != null && pc.value != this.lastCue) {
            this.lastCue = pc.value;
            this.restart();
        }
        if (!this.done) {
            this.t += seconds;
            let c = this.ctx;
            if (c != null) {
                c.markNeedsUpdate();
            }
        }
        return true;
    }
}
